+	void CVBlankTimer::Stop()
+	{
+	    std::unique_lock lock( m_ScheduleMutex );
+
+	    m_bRunning = false;
+
+	    // Wake the nudge thread so it can observe shutdown.
+	    m_bArmed = true;
+	    m_bArmed.notify_all();
+
+	    // Prevent a pending timerfd wakeup during teardown.
+	    if ( UsingTimerFD() )
+	        ITimerWaitable::DisarmTimer();
+	}
+
 	void CVBlankTimer::ArmNextVBlank( bool bPreemptive )
 	{
 		std::unique_lock lock( m_ScheduleMutex );
+		// Do not schedule another frame once shutdown has begun.
+		if ( !m_bRunning )
+			return;
+
 
 		// If we're pre-emptively re-arming, don't
 		// do anything if we are already armed.
