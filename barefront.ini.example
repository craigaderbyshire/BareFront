# BareFront example configuration
#
# The installer will generate the real barefront.ini.
# This file documents the expected format.
#
# {rom} is automatically replaced with the selected ROM path.
# Do NOT quote {rom}; BareFront safely quotes it itself.

[megadrive]
roms=roms/megadrive
screenshots=assets/games/megadrive
emulator=scripts/launch_mednafen_md.sh
arguments={rom}

[nes]
roms=roms/nes
screenshots=assets/games/nes
emulator=scripts/launch_mesen_nes.sh
arguments={rom}

[snes]
roms=roms/snes
screenshots=assets/games/snes
emulator=emulators/bsnes/bsnes
arguments={rom}

[ps1]
roms=roms/ps1
screenshots=assets/games/ps1
emulator=scripts/launch_duckstation.sh
arguments={rom}

[ps2]
roms=roms/ps2
screenshots=assets/games/ps2
emulator=emulators/pcsx2/PCSX2.AppImage
arguments=-batch {rom}

[mastersystem]
roms=roms/mastersystem
screenshots=assets/games/mastersystem
emulator=scripts/launch_mesen_sms.sh
arguments={rom}

[atari2600]
roms=roms/atari2600
screenshots=assets/games/atari2600
emulator=scripts/launch_stella.sh
arguments={rom}

[c64]
roms=roms/c64
screenshots=assets/games/c64
emulator=scripts/launch_vice.sh
arguments={rom}

[arcade]
roms=roms/arcade
screenshots=assets/games/arcade
emulator=scripts/launch_mame.sh
arguments={rom}

[neogeo]
roms=roms/neogeo
screenshots=assets/games/neogeo
emulator=scripts/launch_mame.sh
arguments={rom}

[dreamcast]
roms=roms/dreamcast
screenshots=assets/games/dreamcast
emulator=emulators/flycast/launch_flycast.sh
arguments={rom}

[saturn]
roms=roms/saturn
screenshots=assets/games/saturn
emulator=scripts/launch_mednafen_saturn.sh
arguments={rom}

[pcengine]
roms=roms/pcengine
screenshots=assets/games/pcengine
emulator=scripts/launch_mednafen_pce.sh
arguments={rom}

[jaguar]
roms=roms/jaguar
screenshots=assets/games/jaguar
emulator=scripts/launch_bigpemu.sh
arguments={rom}

[gamecube]
roms=roms/gamecube
screenshots=assets/games/gamecube
emulator=scripts/launch_dolphin.sh
arguments={rom}

[amiga]
roms=roms/amiga
screenshots=assets/games/amiga
emulator=scripts/launch_amiberry.sh
arguments={rom}
