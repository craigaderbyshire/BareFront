<?xml version="1.0"?>
<mamelayout version="2">

    <!--
        BAREFRONT VECTOR — HORIZONTAL TEMPLATE

        Output canvas: 1920 x 1080
        Monitor:       4:3
        Screen:        1280 x 960
        Position:      x=320, y=60

        Layout only.
        No bezel.
        No backdrop.
        No overlay.
        No PNG assets.
    -->

    <view name="BareFront Vector Horizontal">

        <bounds x="0" y="0" width="1920" height="1080"/>

        <screen index="0">
            <bounds x="320" y="60" width="1280" height="960"/>
        </screen>

    </view>

</mamelayout>
